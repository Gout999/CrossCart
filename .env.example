# LOCAL TEST ADAPTER is the default. No money moves.
PAYMENT_PROVIDER=local
CROSSCART_DB=data/crosscart.sqlite
APP_URL=http://127.0.0.1:3107
# For official sandbox: set PAYMENT_PROVIDER=stripe and a TEST key only.
STRIPE_SECRET_KEY=
# Optional: only needed to receive Stripe webhooks; retrieval works without it.
STRIPE_WEBHOOK_SECRET=
# Live shopping interpretation and read-only tool comparison. Confirm all constraints.
# DeepSeek: AI_BASE_URL=https://api.deepseek.com and AI_MODEL=deepseek-flash
# Verify the model is available in your own account.
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=https://api.openai.com/v1
# Optional demo login password; default local-only credential is documented.
DEMO_PASSWORD=

# Public Vercel demo: dedicated PostgreSQL storage; keep every key server-only.
# CROSSCART_PUBLIC_DEMO=true
# DATABASE_URL=your_private_postgres_connection_string
# CRON_SECRET=your_random_private_maintenance_secret
# APP_URL=https://your_public_demo_origin

# Separate approval is required before enabling a private LAN phone test.
# CROSSCART_ENABLE_LAN=true
# CROSSCART_HOST=your_private_interface_IP (APP_URL must match; no wildcard/public host)
